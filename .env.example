# Copy to .env for local development. Do not commit .env.
FASTWAY_API_KEY=

# FastWay quotes supplier prices in USD per 1,000 units.
# The application enforces 1 USD = 3500 TSh internally.

# Free real email delivery (Gmail App Password or Brevo SMTP key)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Royal
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SMTP_TIMEOUT=15

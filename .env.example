# Copy to .env for local development. Do not commit .env.
FASTWAY_API_KEY=

# FastWay quotes supplier prices in USD per 1,000 units.
# The application enforces 1 USD = 3500 TSh internally.

# Free real email delivery (Brevo SMTP key)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b9ff5f001@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM_NAME=Royal
SMTP_FROM_EMAIL=your-verified-brevo-sender@example.com
SMTP_REPLY_TO=your-verified-brevo-sender@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=8
